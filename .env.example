# Copy to .env.local and fill in. Nothing here is read at build time.

# Postgres. On Supabase this is Settings → Database → Connection string →
# Transaction pooler (port 6543); the direct connection on 5432 exhausts
# connections on serverless.
DATABASE_URL=postgres://user:password@host:6543/postgres

# The single operator password for /admin.
ADMIN_PASSWORD=

# openssl rand -hex 32
ADMIN_SESSION_SECRET=
